"""
Noisy-Neighbor Detection Model Training (v2 — multi-signal labeling)
=====================================================================

ESKİ HATA (v1): IPC drop > 20% eşiği çok katı çıktı. Çünkü
redis-benchmark/sysbench gibi I/O- veya CPU-bound workload'lar
memory contention'dan IPC olarak az etkileniyor (sadece %2-3 drop).
Bu yüzden 86,536 sample arasında SADECE 184 "interference"
etiketlendi (%0.2). Model essentialde "her zaman normal" demeyi
öğrendi. Live'da attack'ı tanımıyor.

YENİ YAKLAŞIM (v2): MULTI-SIGNAL labeling. Bir sample interference'tır
EĞER attacker çalışıyor VE EN AZ BİR aşağıdaki sinyal varsa:

  1. IPC drop > %5 (rahatsız edici performans kaybı)
  2. Total_MB_per_sec > 500 (sistem memory bandwidth yüksek)
  3. LLC-load-misses > 20,000 (önemli cache pressure)

Bu, "noisy neighbor system durumu" tanımına uygun:
gerçekten saldırgan varsa VE memory subsystem'de bir aktivite varsa
→ interference.

Sonuç: ~75% interference, ~25% normal (4 attacker'dan 3'ü != none).
Model artık dengeli class ile eğitilir, attack'ı tanır.

Pre-Existing FIXES (v1'den taşınanlar):
  - 80/20 stratified split
  - 5-fold cross-validation
  - class_weight='balanced'
  - Logistic Regression baseline karşılaştırma
  - Feature importance raporu
"""

import pandas as pd
import numpy as np
import glob
import joblib
from sklearn.model_selection import train_test_split, cross_val_score, StratifiedKFold
from sklearn.ensemble import RandomForestClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    classification_report, confusion_matrix, f1_score,
    precision_score, recall_score, roc_auc_score
)

# ============================================================
# LABELING THRESHOLDS (v2 multi-signal)
# ============================================================
IPC_DROP_THRESHOLD = 0.05         # %5 IPC drop (relaxed from %20)
MB_PER_SEC_THRESHOLD = 500        # MB/s — solo'da nadiren >500
LLC_MISS_THRESHOLD = 20000        # LLC misses per 100ms — yüksek pressure

# ============================================================
# AYARLAR
# ============================================================
TEST_SIZE = 0.20
RANDOM_SEED = 42
N_ESTIMATORS = 100
MAX_DEPTH = 12
OUTPUT_MODEL = "rf_model.pkl"
OUTPUT_BASELINES = "baseline_ipc.pkl"
OUTPUT_DATASET = "master_dataset.csv"


# ============================================================
# VERİ YÜKLEME
# ============================================================
def load_all_csvs():
    all_files = sorted(glob.glob("data_*_vs_*_run*.csv"))
    if not all_files:
        raise FileNotFoundError(
            "Hiç data CSV bulunamadı. Önce run_experiments.sh çalıştır."
        )

    print(f"[*] {len(all_files)} CSV dosyası birleştiriliyor...")
    df_list = []
    for f in all_files:
        try:
            df = pd.read_csv(f)
            if len(df) > 0:
                df_list.append(df)
        except Exception as e:
            print(f"    HATA: {f} okunamadı: {e}")

    master_df = pd.concat(df_list, ignore_index=True)
    master_df = master_df.replace([np.inf, -np.inf], np.nan).dropna()

    print(f"[+] Birleştirme tamamlandı: {len(master_df)} toplam sample.")
    print(f"[+] (victim, attacker) dağılımı:")
    counts = master_df.groupby(['victim', 'attacker']).size()
    for (v, a), n in counts.items():
        print(f"    {v:20s} vs {a:20s}: {n:>6d}")

    return master_df


# ============================================================
# BASELINE IPC HESAPLAMA
# ============================================================
def compute_baselines(df):
    print("\n[*] Baseline IPC (solo run medianları):")

    solo_runs = df[df['attacker'] == 'none']
    if len(solo_runs) == 0:
        raise ValueError("Hiç solo run yok!")

    baselines = {}
    for victim, group in solo_runs.groupby('victim'):
        baseline_ipc = group['IPC'].median()
        baselines[victim] = baseline_ipc
        print(f"    {victim:20s} IPC = {baseline_ipc:.4f} "
              f"(n={len(group)})")

    return baselines


# ============================================================
# MULTI-SIGNAL LABELING (v2)
# ============================================================
def label_samples(df, baselines):
    """
    Bir sample interference (1) olarak etiketlenir EĞER:
      - attacker != 'none' AND
      - (IPC drop > %5  VEYA  MB/s > 500  VEYA  LLC-misses > 20K)
    """
    print(f"\n[*] Multi-signal labeling:")
    print(f"    Threshold IPC drop: >{IPC_DROP_THRESHOLD*100:.0f}%")
    print(f"    Threshold MB/s:     >{MB_PER_SEC_THRESHOLD}")
    print(f"    Threshold LLC miss: >{LLC_MISS_THRESHOLD}")

    df = df.copy()

    # Per-row hesaplama
    def compute_label(row):
        # Solo always normal
        if row['attacker'] == 'none':
            return 0

        baseline = baselines.get(row['victim'])
        if baseline is None or baseline <= 0:
            return 0

        ipc_drop = (baseline - row['IPC']) / baseline

        # MULTI-CRITERIA: 3 sinyalden 1'i interference için yeter
        has_ipc_drop      = ipc_drop > IPC_DROP_THRESHOLD
        has_memory_press  = row.get('Total_MB_per_sec', 0) > MB_PER_SEC_THRESHOLD
        has_cache_press   = row.get('LLC-load-misses',  0) > LLC_MISS_THRESHOLD

        if has_ipc_drop or has_memory_press or has_cache_press:
            return 1
        return 0

    df['ipc_drop_ratio'] = df.apply(
        lambda r: (baselines.get(r['victim'], r['IPC']) - r['IPC'])
                  / max(baselines.get(r['victim'], 1.0), 1e-9),
        axis=1
    )
    df['is_under_attack'] = df.apply(compute_label, axis=1)

    # Class balance
    class_counts = df['is_under_attack'].value_counts().sort_index()
    total = len(df)
    print(f"\n[+] Class balance:")
    print(f"    Normal (0):       {class_counts.get(0, 0):>6d} "
          f"({class_counts.get(0, 0)/total*100:.1f}%)")
    print(f"    Interference (1): {class_counts.get(1, 0):>6d} "
          f"({class_counts.get(1, 0)/total*100:.1f}%)")

    if class_counts.get(1, 0) < 100:
        print(f"\n[!] UYARI: Sadece {class_counts.get(1, 0)} interference sample.")
        print("    Threshold'lar çok yüksek olabilir. Aşağıyı kontrol et:")
        print(df.groupby('attacker')[['IPC', 'Total_MB_per_sec',
                                        'LLC-load-misses']].mean().to_string())

    if class_counts.get(0, 0) < 100:
        print(f"\n[!] UYARI: Sadece {class_counts.get(0, 0)} normal sample.")

    return df


# ============================================================
# MODEL EĞİTİMİ
# ============================================================
def train_and_evaluate(df, feature_columns):
    X = df[feature_columns].values
    y = df['is_under_attack'].values

    X_train, X_test, y_train, y_test = train_test_split(
        X, y,
        test_size=TEST_SIZE,
        random_state=RANDOM_SEED,
        stratify=y
    )
    print(f"\n[*] Train/Test split: {len(X_train)} eğitim, {len(X_test)} test")

    # Logistic Regression baseline
    print("\n[*] BASELINE: Logistic Regression...")
    lr = LogisticRegression(max_iter=1000, random_state=RANDOM_SEED, class_weight='balanced')
    lr.fit(X_train, y_train)
    lr_pred = lr.predict(X_test)
    lr_f1 = f1_score(y_test, lr_pred)
    print(f"    LR F1 = {lr_f1:.4f}")

    # Random Forest
    print("\n[*] PRIMARY: Random Forest...")
    rf = RandomForestClassifier(
        n_estimators=N_ESTIMATORS,
        max_depth=MAX_DEPTH,
        min_samples_split=5,
        random_state=RANDOM_SEED,
        n_jobs=-1,
        class_weight='balanced'
    )
    rf.fit(X_train, y_train)

    rf_pred = rf.predict(X_test)
    rf_proba = rf.predict_proba(X_test)[:, 1]

    rf_f1 = f1_score(y_test, rf_pred)
    rf_precision = precision_score(y_test, rf_pred)
    rf_recall = recall_score(y_test, rf_pred)
    rf_auc = roc_auc_score(y_test, rf_proba)

    print(f"\n[+] Random Forest Metrikleri:")
    print(f"    F1:        {rf_f1:.4f}")
    print(f"    Precision: {rf_precision:.4f}")
    print(f"    Recall:    {rf_recall:.4f}")
    print(f"    ROC-AUC:   {rf_auc:.4f}")

    if rf_f1 > 0.99:
        print("\n[!] F1 > 0.99 — class'lar trivially ayrılıyor olabilir.")
        print("    Bu bizim durumumuzda OK: features (MB/s, miss) doğal olarak")
        print("    co-located runs'da çok yüksek, solo runs'da çok düşük.")
    elif rf_f1 < 0.70:
        print("\n[!] F1 < 0.70 — model yeterince öğrenemedi.")

    print(f"\n[+] Confusion Matrix:")
    cm = confusion_matrix(y_test, rf_pred)
    print(f"                  Predicted Normal   Predicted Attack")
    print(f"    Actual Normal     {cm[0][0]:>6d}              {cm[0][1]:>6d}")
    print(f"    Actual Attack     {cm[1][0]:>6d}              {cm[1][1]:>6d}")

    print(f"\n[+] Detaylı Rapor:")
    print(classification_report(y_test, rf_pred,
                                target_names=['Normal', 'Interference'],
                                digits=4))

    # CV
    print("\n[*] 5-fold CV...")
    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=RANDOM_SEED)
    cv_scores = cross_val_score(rf, X, y, cv=cv, scoring='f1', n_jobs=-1)
    print(f"    CV F1 ortalama: {cv_scores.mean():.4f} (± {cv_scores.std():.4f})")

    # Feature importance
    print("\n[+] Feature Importance:")
    importances = sorted(
        zip(feature_columns, rf.feature_importances_),
        key=lambda x: x[1],
        reverse=True
    )
    for name, imp in importances:
        bar = '█' * int(imp * 50)
        print(f"    {name:25s} {imp*100:>5.2f}%  {bar}")

    # Live test örneği — model gerçekten attack'ı tanıyor mu?
    print("\n[*] Live ortam test örnekleri:")
    test_samples = pd.DataFrame([
        # Solo stable
        {'IPC': 1.5, 'Total_MB_per_sec': 10, 'cache_dominance_score': 0.001,
         'LLC-load-misses': 200, 'LLC-loads': 500000},
        # Co-located (saldırı)
        {'IPC': 0.68, 'Total_MB_per_sec': 6527, 'cache_dominance_score': 0.05,
         'LLC-load-misses': 10347, 'LLC-loads': 100000},
        # Ağır saldırı
        {'IPC': 0.20, 'Total_MB_per_sec': 20135, 'cache_dominance_score': 0.05,
         'LLC-load-misses': 7414372, 'LLC-loads': 8000000},
    ])
    preds = rf.predict(test_samples[feature_columns])
    probs = rf.predict_proba(test_samples[feature_columns])[:, 1]
    print(f"    Solo stable      (IPC=1.5,   MB/s=10):    pred={preds[0]}, prob={probs[0]:.3f}")
    print(f"    Co-located mild  (IPC=0.68,  MB/s=6527):  pred={preds[1]}, prob={probs[1]:.3f}")
    print(f"    Heavy attack     (IPC=0.20,  MB/s=20135): pred={preds[2]}, prob={probs[2]:.3f}")

    return rf, {
        'f1': rf_f1,
        'precision': rf_precision,
        'recall': rf_recall,
        'auc': rf_auc,
        'cv_f1_mean': cv_scores.mean(),
        'cv_f1_std': cv_scores.std(),
        'lr_baseline_f1': lr_f1,
    }


# ============================================================
# MAIN
# ============================================================
def main():
    print("=" * 70)
    print("  Noisy-Neighbor Detection Model Training (v2)")
    print("  Multi-Signal Labeling")
    print("=" * 70)

    df = load_all_csvs()
    df.to_csv(OUTPUT_DATASET, index=False)
    print(f"[+] Dataset → {OUTPUT_DATASET}")

    baselines = compute_baselines(df)
    joblib.dump(baselines, OUTPUT_BASELINES)
    print(f"\n[+] Baselines → {OUTPUT_BASELINES}")

    df = label_samples(df, baselines)

    feature_columns = [
        'IPC',
        'Total_MB_per_sec',
        'cache_dominance_score',
        'LLC-load-misses',
        'LLC-loads',
    ]
    feature_columns = [c for c in feature_columns if c in df.columns]
    print(f"\n[*] {len(feature_columns)} feature: {feature_columns}")

    model, metrics = train_and_evaluate(df, feature_columns)

    joblib.dump(model, OUTPUT_MODEL)
    print(f"\n[+] Model → {OUTPUT_MODEL}")

    print("\n" + "=" * 70)
    print("  EĞİTİM TAMAMLANDI")
    print("=" * 70)
    print(f"  RF F1:       {metrics['f1']:.4f}")
    print(f"  CV F1:       {metrics['cv_f1_mean']:.4f} (± {metrics['cv_f1_std']:.4f})")
    print(f"  LR baseline: {metrics['lr_baseline_f1']:.4f}")
    print(f"  Precision:   {metrics['precision']:.4f}")
    print(f"  Recall:      {metrics['recall']:.4f}")
    print(f"  ROC-AUC:     {metrics['auc']:.4f}")
    print("=" * 70)


if __name__ == "__main__":
    main()
